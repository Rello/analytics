              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ocs": {
                      "type": "object",
                      "properties": {
                        "meta": {
                          "$ref": "#/components/schemas/OCSMeta"
                        },
                        "data": {}
                      },
                      "required": [
