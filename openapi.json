          "favorite": {
            "type": "integer"
          },
          "item_type": {
            "type": "string"
          },
          "shareId": {
            "oneOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "id",
          "type",
          "name"
        ]
      },
      "ReportMetadata": {
        "type": "object",
        "properties": {
