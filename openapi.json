          "status": {
            "type": "string"
          },
          "statuscode": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "statuscode",
          "message"
        ]
      },
      "ReportSummary": {
        "type": "object",
        "properties": {
          "id": {
            "oneOf": [
