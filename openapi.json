    "/ocs/v2.php/apps/analytics/api/v1/reports/{reportId}/data": {
      "get": {
        "operationId": "getReportData",
        "summary": "Get report data with saved filters",
        "description": "Includes reports shared with the user, their groups, or through report folders. Excludes public-link-only and panorama-only access. Uses the report viewer backend pipeline, including saved filters, variables, sorting and transformations. No temporary filter overrides. Browser-side formatting and pivots are not rendered. Datasource failures use the payload error field.",
        "tags": [
          "analytics"
        ],
        "security": [
          {
            "basic_auth": []
          }
        ],
        "parameters": [
          {
            "name": "OCS-APIRequest",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "reportId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Accessible report ID; folders are not reports"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ocs": {
                      "type": "object",
                      "properties": {
                        "meta": {
                          "$ref": "#/components/schemas/OCSMeta"
                        },
                        "data": {
                          "$ref": "#/components/schemas/ReportData"
                        }
                      },
                      "required": [
                        "meta",
                        "data"
                      ]
                    }
                  },
                  "required": [
                    "ocs"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ocs": {
                      "type": "object",
                      "properties": {
                        "meta": {
                          "$ref": "#/components/schemas/OCSMeta"
                        },
                        "data": {}
                      },
                      "required": [
                        "meta",
                        "data"
                      ]
                    }
                  },
                  "required": [
                    "ocs"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Report missing or inaccessible",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ocs": {
                      "type": "object",
                      "properties": {
                        "meta": {
                          "$ref": "#/components/schemas/OCSMeta"
                        },
                        "data": {}
                      },
                      "required": [
                        "meta",
                        "data"
                      ]
                    }
                  },
                  "required": [
                    "ocs"
                  ]
                }
              }
            }
          }
        }
      }
