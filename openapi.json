{
  "openapi": "3.0.0",
  "info": {
    "title": "Analytics OCS API",
    "version": "1.0.0"
  },
  "paths": {
    "/ocs/v2.php/apps/analytics/createFromDataFile": {
      "post": {
        "summary": "Create analytics report from a data file",
        "operationId": "createFromDataFile",
        "tags": [
          "analytics"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fileId": {
                    "type": "integer",
                    "description": "ID of the file to import"
                  }
                },
                "required": [
                  "fileId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Report created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ocs": {
                      "type": "object",
                      "properties": {
                        "meta": {
                          "$ref": "#/components/schemas/OCSMeta"
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "version": {
                              "type": "string"
                            },
                            "root": {
                              "type": "object",
                              "properties": {
                                "orientation": {
                                  "type": "string"
                                },
                                "rows": {
                                  "type": "array",
                                  "items": {
                                    "type": "object"
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "required": [
                        "meta",
                        "data"
                      ]
                    }
                  },
                  "required": [
                    "ocs"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "File not found"
          },
          "400": {
            "description": "fileId missing",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ocs": {
                      "type": "object",
                      "properties": {
                        "meta": {
                          "$ref": "#/components/schemas/OCSMeta"
                        },
                        "data": {
                          "type": "object",
                          "properties": {
                            "error": {
                              "type": "string"
                            }
                          }
                        }
                      },
                      "required": [
                        "meta",
                        "data"
                      ]
                    }
                  },
                  "required": [
                    "ocs"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ocs": {
                      "type": "object",
                      "properties": {
                        "meta": {
                          "$ref": "#/components/schemas/OCSMeta"
                        },
                        "data": {}
                      },
                      "required": [
                        "meta",
                        "data"
                      ]
                    }
                  },
                  "required": [
                    "ocs"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "basic_auth": []
          }
        ],
        "parameters": [
          {
            "name": "OCS-APIRequest",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          }
        ]
      }
    },
    "/ocs/v2.php/apps/analytics/api/v1/reports": {
      "get": {
        "operationId": "listReports",
        "summary": "List owned and shared reports",
        "description": "Includes reports shared with the user, their groups, or through report folders. Excludes public-link-only and panorama-only access.",
