    "/ocs/v2.php/apps/analytics/api/v1/datasets": {
      "get": {
        "operationId": "listDatasets",
        "summary": "List owned datasets",
        "description": "List owned datasets with only their ID, name and column labels. Shared reports do not grant dataset write access. The legacy V3 dataset response is unchanged.",
        "tags": [
          "analytics"
        ],
        "security": [
          {
            "basic_auth": []
          }
        ],
        "parameters": [
          {
            "name": "OCS-APIRequest",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Owned datasets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ocs"
                  ],
                  "properties": {
                    "ocs": {
                      "type": "object",
                      "required": [
                        "meta",
                        "data"
                      ],
                      "properties": {
                        "meta": {
                          "$ref": "#/components/schemas/OCSMeta"
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "id",
                              "name"
                            ],
                            "properties": {
                              "id": {
                                "oneOf": [
                                  {
                                    "type": "integer"
                                  },
                                  {
                                    "type": "string"
                                  }
                                ]
                              },
                              "name": {
                                "type": "string",
                                "nullable": true
                              },
                              "dimension1": {
                                "type": "string",
                                "nullable": true
                              },
                              "dimension2": {
                                "type": "string",
                                "nullable": true
                              },
                              "value": {
                                "type": "string",
                                "nullable": true
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ocs": {
                      "type": "object",
                      "properties": {
                        "meta": {
